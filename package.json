{
  "name": "tapeout-dojo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "TAPEOUT — a first-person 3D RPG that teaches Verilog with a real in-browser compiler, four-state simulator, and RTL export.",
  "author": "Joshua Speck",
  "license": "MIT",
  "homepage": "https://jspeck12-bot.github.io/tapeout-dojo/",
  "repository": {
    "type": "git",
    "url": "https://github.com/jspeck12-bot/tapeout-dojo.git"
  },
  "keywords": [
    "verilog",
    "hdl",
    "education",
    "threejs",
    "rpg",
    "tiny-tapeout",
    "chip-design"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "gate": "node dev/gate.cjs",
    "gate:layout": "node dev/validate.cjs",
    "gate:content": "node dev/test_content.cjs",
    "gate:visual": "node dev/visual.cjs",
    "gate:smoke": "node dev/smoke.cjs",
    "gate:engine": "vitest run"
  },
  "dependencies": {
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "three": "0.128.0",
    "lucide-react": "0.383.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.4.0",
    "esbuild": "^0.23.0",
    "react-test-renderer": "18.2.0",
    "valibot": "^1.1.0",
    "vitest": "^2.1.9"
  }
}
